<mxfile host="app.diagrams.net" modified="2026-04-27T13:01:46.912626+00:00" agent="Codex" version="24.7.17" type="device"><diagram id="post-pipeline-metrics" name="Page-1"><mxGraphModel dx="1820" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1880" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="Post-Processing Pipeline: Subject-Level and Population-Level Metrics" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=40;fontStyle=1;fontColor=#0F172A;" vertex="1"><mxGeometry as="geometry" x="220" y="20" width="1460" height="54" /></mxCell><mxCell id="subtitle" parent="1" value="SimNIBS TI workflow for one ROI, showing what is collected per subject and what is computed across subjects and repeats" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=20;fontColor=#334155;" vertex="1"><mxGeometry as="geometry" x="190" y="72" width="1520" height="30" /></mxCell><mxCell id="box_10" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="70" y="180" width="360" height="250" /></mxCell><mxCell id="box_10_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#334155;" vertex="1"><mxGeometry as="geometry" x="71" y="181" width="358" height="48" /></mxCell><mxCell id="box_10_title" parent="1" value="1. Analysis Inputs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=18;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="78" y="186" width="344" height="34" /></mxCell><mxCell id="box_10_body" parent="1" value="&lt;div style='line-height:1.42;'&gt;• TI field on the subject TI grid&lt;br/&gt;• Target ROI mask on the TI grid&lt;br/&gt;• MNI baseline field for the same ROI&lt;br/&gt;• Fixed MNI neighboring-region template&lt;br/&gt;• Anatomical and electrode geometry&lt;br/&gt;• Repeat identity within the ROI batch&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=18;spacingRight=18;spacingTop=16;strokeColor=none;fillColor=none;fontSize=17;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="71" y="230" width="358" height="199" /></mxCell><mxCell id="box_11" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="500" y="130" width="1320" height="590" /></mxCell><mxCell id="box_11_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;" vertex="1"><mxGeometry as="geometry" x="501" y="131" width="1318" height="48" /></mxCell><mxCell id="box_11_title" parent="1" value="2. Subject-Level Metrics (Per Subject × Per Repeat)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=18;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="508" y="136" width="1304" height="34" /></mxCell><mxCell id="box_11_body" parent="1" value="&lt;div style='line-height:1.42;'&gt;Whole-brain threshold metrics:&lt;br/&gt;• percentile_value, top_percentile_voxels&lt;br/&gt;ROI overlap metrics:&lt;br/&gt;• roi_voxels, overlap_top_voxels, roi_volume_mm3, overlap_volume_mm3, overlap_fraction, roi_percentile_value&lt;br/&gt;ROI intensity and MNI-comparison metrics:&lt;br/&gt;• roi_peak, roi_mean, roi_peak_abs_delta_mni, roi_mean_abs_delta_mni&lt;br/&gt;Focality metrics:&lt;br/&gt;• focality_voxels_gt_threshold, focality_volume_mm3_gt_threshold, focality_voxels_abs_delta_mni, focality_volume_mm3_abs_delta_mni&lt;br/&gt;Neighbor-exposure metrics:&lt;br/&gt;• neighbor_mean_of_means, neighbor_max_of_max, neighbor_min_of_max&lt;br/&gt;Anatomical context metrics:&lt;br/&gt;• csf_distance_mm, skull_distance_mm, electrode_distance_mean_mm, electrode_distance_min_mm, electrode_distance_max_mm&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=18;spacingRight=18;spacingTop=16;strokeColor=none;fillColor=none;fontSize=17;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="501" y="180" width="1318" height="539" /></mxCell><mxCell id="box_12" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F7FEE7;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="90" y="880" width="800" height="590" /></mxCell><mxCell id="box_12_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#4D7C0F;strokeColor=#4D7C0F;" vertex="1"><mxGeometry as="geometry" x="91" y="881" width="798" height="48" /></mxCell><mxCell id="box_12_title" parent="1" value="3A. Within-Run Population Metrics (All Subjects in One Repeat)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=18;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="98" y="886" width="784" height="34" /></mxCell><mxCell id="box_12_body" parent="1" value="&lt;div style='line-height:1.42;'&gt;Across subjects within one repeat:&lt;br/&gt;• atlas-region mean and peak distributions&lt;br/&gt;• mean, median, IQR, SD, CV, min, max&lt;br/&gt;• fraction above threshold for regional peak fields&lt;br/&gt;• neighbor-region summaries across subjects&lt;br/&gt;• subject-level ROI intensity and focality distributions&lt;br/&gt;• anatomy-to-performance correlations&lt;br/&gt;• worst-case subjects: lowest ROI peak, largest absolute delta, and broadest focality&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=18;spacingRight=18;spacingTop=16;strokeColor=none;fillColor=none;fontSize=17;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="91" y="930" width="798" height="539" /></mxCell><mxCell id="box_13" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="1010" y="880" width="810" height="650" /></mxCell><mxCell id="box_13_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#C2410C;" vertex="1"><mxGeometry as="geometry" x="1011" y="881" width="808" height="48" /></mxCell><mxCell id="box_13_title" parent="1" value="3B. Across-Repeat Repeatability Metrics (All Repeats for One ROI)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=18;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="1018" y="886" width="794" height="34" /></mxCell><mxCell id="box_13_body" parent="1" value="&lt;div style='line-height:1.42;'&gt;Across the 10 repeats for one ROI:&lt;br/&gt;• complete-case subject cohort&lt;br/&gt;Repeat-level population summaries:&lt;br/&gt;• per-run n, mean, SD, SEM, 95% CI, median, IQR, min, max, CV&lt;br/&gt;Experiment-level repeatability metrics:&lt;br/&gt;• SD of run means, mean absolute pairwise difference&lt;br/&gt;• pooled within-subject SD, SEM, coefficient of repeatability&lt;br/&gt;• pooled within-subject CV and ICC(A,1)&lt;br/&gt;• Friedman p value and Kendall&amp;#x27;s W&lt;br/&gt;• drift slope, drift p value, drift R²&lt;br/&gt;• subject / repeat / residual variance fractions&lt;br/&gt;Subject-level repeat summaries:&lt;br/&gt;• subject mean across repeats&lt;br/&gt;• subject SD, CV, mean absolute pairwise difference&lt;br/&gt;• SD relative to pooled repeatability&lt;br/&gt;• subject-specific drift slope and R²&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=18;spacingRight=18;spacingTop=16;strokeColor=none;fillColor=none;fontSize=17;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="1011" y="930" width="808" height="599" /></mxCell><mxCell id="box_14" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="60" y="1700" width="1780" height="170" /></mxCell><mxCell id="box_14_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#475569;" vertex="1"><mxGeometry as="geometry" x="61" y="1701" width="1778" height="48" /></mxCell><mxCell id="box_14_title" parent="1" value="Definitions and Interpretation Notes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=18;fontSize=24;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="68" y="1706" width="1764" height="34" /></mxCell><mxCell id="box_14_body" parent="1" value="&lt;div style='line-height:1.42;'&gt;• ROI = region of interest. MNI = Montreal Neurological Institute template. IQR = interquartile range. CV = coefficient of variation.&lt;br/&gt;• ICC(A,1) = absolute-agreement intraclass correlation. SEM = standard error of measurement. CSF = cerebrospinal fluid.&lt;br/&gt;• percentile_value is the whole-brain percentile cutoff used to define the top-field mask, whereas roi_percentile_value is the same percentile computed only inside the target ROI.&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=18;spacingRight=18;spacingTop=16;strokeColor=none;fillColor=none;fontSize=17;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="61" y="1750" width="1778" height="119" /></mxCell><mxCell id="split" parent="1" style="ellipse;html=1;aspect=fixed;strokeColor=#334155;fillColor=#334155;" vertex="1"><mxGeometry as="geometry" x="1443" y="808" width="14" height="14" /></mxCell><mxCell id="branch_note" parent="1" value="Subject-level repeated measurements feed both population analyses" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#334155;" vertex="1"><mxGeometry as="geometry" x="565" y="839" width="860" height="26" /></mxCell><mxCell id="split_label" parent="1" value="split" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#475569;" vertex="1"><mxGeometry as="geometry" x="1420" y="839" width="60" height="22" /></mxCell><mxCell id="edge_100" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=0;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=4;endArrow=block;endFill=1;exitX=1.0;exitY=0.48;entryX=0.0;entryY=0.42;" edge="1" source="box_10" target="box_11"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_label_100" parent="1" value="subject-level inputs" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#334155;" vertex="1"><mxGeometry as="geometry" x="335" y="294" width="190" height="24" /></mxCell><mxCell id="edge_101" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=0;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=4;endArrow=block;endFill=1;exitX=0.72;exitY=1.0;entryX=0.5;entryY=0.0;" edge="1" source="box_11" target="split"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge_102" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=0;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=4;endArrow=block;endFill=1;exitX=0.0;exitY=0.5;entryX=0.5;entryY=0.0;" edge="1" source="split" target="box_12"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="490" y="815" /><mxPoint x="490" y="880" /></Array></mxGeometry></mxCell><mxCell id="edge_label_102" parent="1" value="all subjects within one repeat" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#334155;" vertex="1"><mxGeometry as="geometry" x="525" y="644" width="190" height="24" /></mxCell><mxCell id="edge_103" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=0;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=4;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=0.5;entryY=0.0;" edge="1" source="split" target="box_13"><mxGeometry as="geometry" relative="1"><Array as="points"><mxPoint x="1415" y="815" /><mxPoint x="1415" y="880" /></Array></mxGeometry></mxCell><mxCell id="edge_label_103" parent="1" value="all repeats for one ROI" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#334155;" vertex="1"><mxGeometry as="geometry" x="1420" y="644" width="190" height="24" /></mxCell></root></mxGraphModel></diagram></mxfile>