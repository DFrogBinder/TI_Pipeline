<mxfile host="app.diagrams.net" modified="2026-05-01T10:55:06.380532+00:00" agent="Codex" version="24.7.17" type="device"><diagram id="post_pipeline_metric_flowchart_across_repeat_repeatability_metrics" name="Page-1"><mxGraphModel dx="1820" dy="1720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4260" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" parent="1" value="Across-Repeat Analysis Outputs" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=72;fontStyle=1;fontColor=#0F172A;" vertex="1"><mxGeometry as="geometry" x="320" y="30" width="3620" height="96" /></mxCell><mxCell id="subtitle" parent="1" value="What the automatic repeatability stage reads, computes, and writes for one ROI after complete-case cohort selection" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;fontSize=36;fontColor=#334155;" vertex="1"><mxGeometry as="geometry" x="220" y="122" width="3820" height="56" /></mxCell><mxCell id="box_10" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="100" y="330" width="980" height="320" /></mxCell><mxCell id="box_10_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#334155;strokeColor=#334155;" vertex="1"><mxGeometry as="geometry" x="101" y="331" width="978" height="96" /></mxCell><mxCell id="box_10_title" parent="1" value="Repeatability Analysis Inputs" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=30;fontSize=46;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="110" y="348" width="960" height="60" /></mxCell><mxCell id="box_10_body" parent="1" value="&lt;div style='font-size:36px;line-height:1.24;color:#0F172A;'&gt;&lt;ul style='margin:4px 0 0 22px;padding-left:24px;'&gt;&lt;li style='margin:0 0 8px 0;'&gt;Complete-case subjects present in every selected repeat&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;Per-subject scalar metrics across repeats&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;Saved NIfTI masks and ROI field volumes&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;Optional log summaries for failure auditing&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=14;strokeColor=none;fillColor=none;fontSize=36;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="101" y="434" width="978" height="214" /></mxCell><mxCell id="box_11" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="1250" y="220" width="1260" height="500" /></mxCell><mxCell id="box_11_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#C2410C;strokeColor=#C2410C;" vertex="1"><mxGeometry as="geometry" x="1251" y="221" width="1258" height="96" /></mxCell><mxCell id="box_11_title" parent="1" value="Scalar and Subject-Level Repeatability" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=30;fontSize=46;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="1260" y="238" width="1240" height="60" /></mxCell><mxCell id="box_11_body" parent="1" value="&lt;div style='font-size:36px;line-height:1.24;color:#0F172A;'&gt;&lt;ul style='margin:4px 0 0 22px;padding-left:24px;'&gt;&lt;li style='margin:0 0 8px 0;'&gt;per-run n, mean, SD, SEM, 95% CI&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;median, IQR, min, max, CV&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;mean and max absolute pairwise difference&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;SD of run means&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;subject mean, SD, CV&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;subject-specific drift, SD ratio, top unstable subjects&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=14;strokeColor=none;fillColor=none;fontSize=36;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="1251" y="324" width="1258" height="394" /></mxCell><mxCell id="box_12" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="2690" y="220" width="1420" height="500" /></mxCell><mxCell id="box_12_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;" vertex="1"><mxGeometry as="geometry" x="2691" y="221" width="1418" height="96" /></mxCell><mxCell id="box_12_title" parent="1" value="Image-Level Repeatability" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=30;fontSize=46;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="2700" y="238" width="1400" height="60" /></mxCell><mxCell id="box_12_body" parent="1" value="&lt;div style='font-size:36px;line-height:1.24;color:#0F172A;'&gt;&lt;ul style='margin:4px 0 0 22px;padding-left:24px;'&gt;&lt;li style='margin:0 0 8px 0;'&gt;pairwise Dice and Jaccard for ROI, top-5%, and overlap masks&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;within-ROI voxelwise field correlations across repeats&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;voxel SD and CV summaries inside the ROI&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;ROI mean, ROI P95, and ROI peak field repeatability&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;peak displacement and overlap-mask COM displacement&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=14;strokeColor=none;fillColor=none;fontSize=36;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="2691" y="324" width="1418" h