olor=none;fillColor=none;fontSize=36;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="1281" y="354" width="2858" height="244" /></mxCell><mxCell id="box_12" parent="1" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F5F9FF;strokeColor=#1E293B;" vertex="1"><mxGeometry as="geometry" x="760" y="790" width="2700" height="300" /></mxCell><mxCell id="box_12_header" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;" vertex="1"><mxGeometry as="geometry" x="761" y="791" width="2698" height="96" /></mxCell><mxCell id="box_12_title" parent="1" value="Cohort Outputs and Effects" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=30;fontSize=46;fontStyle=1;fontColor=#FFFFFF;" vertex="1"><mxGeometry as="geometry" x="770" y="808" width="2680" height="60" /></mxCell><mxCell id="box_12_body" parent="1" value="&lt;div style='font-size:36px;line-height:1.24;color:#0F172A;'&gt;&lt;ul style='margin:4px 0 0 22px;padding-left:24px;'&gt;&lt;li style='margin:0 0 8px 0;'&gt;Batch mode reruns within-run population summaries on the complete-case cohort&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;Across-repeat repeatability defaults to the same complete-case cohort&lt;/li&gt;&lt;li style='margin:0 0 8px 0;'&gt;Loose descriptive mode is available only when explicitly requested&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=24;spacingRight=24;spacingTop=14;strokeColor=none;fillColor=none;fontSize=36;fontColor=#0F172A;overflow=fill;" vertex="1"><mxGeometry as="geometry" x="761" y="894" width="2698" height="194" /></mxCell><mxCell id="edge_300" parent="1" style="edgeStyle=orthogonalEdgeStyle;orthogonalLoop=1;rounded=0;jettySize=auto;html=1;strokeColor=#334155;strokeWidth=5;endArrow=block;endFill=1;exitX=1.0;exitY=0.5;entryX=0.0;entryY=0.5;" edge="1" source="box_10" target="box_11"><mxGeometry as="geometry" relati