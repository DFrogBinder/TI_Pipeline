        <mxCell id="scope_body" parent="1" value="&lt;div style='font-size:16px;line-height:1.22;color:#0F172A;'&gt;&lt;ul style='margin:4px 0 0 18px;padding-left:18px;'&gt;&lt;li style='margin:0 0 6px 0;'&gt;Batch root contains sibling repeat directories for the same target ROI&lt;/li&gt;&lt;li style='margin:0 0 6px 0;'&gt;Each repeat contributes discovered subject post-processing outputs&lt;/li&gt;&lt;li style='margin:0 0 6px 0;'&gt;The ROI scope is fixed before subject-set intersection&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;strokeColor=none;fillColor=none;fontSize=16;fontFamily=Helvetica;fontColor=#0F172A;overflow=fill;" vertex="1">
