<mxfile host="Electron" agent="codex">
  <diagram id="post-processing-flow" name="Post-Processing Pipeline">
    <mxGraphModel dx="1828" dy="978" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="2700" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#0f172a;" value="Paired Repeatability Post-Processing Pipeline" vertex="1">
          <mxGeometry height="32" width="1100" x="40" y="18" as="geometry" />
        </mxCell>
        <mxCell id="3" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=13;fontColor=#475569;" value="Implemented in &lt;b&gt;post/repeatability_experiment_report.py&lt;/b&gt; and &lt;b&gt;post/mesh_repeat_report.py&lt;/b&gt;" vertex="1">
          <mxGeometry height="22" width="1200" x="40" y="54" as="geometry" />
        </mxCell>
        <mxCell id="10" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=16;fontColor=#0f172a;align=center;verticalAlign=top;spacingLeft=16;spacingTop=12;" value="Phase 1. Driver And Scope Resolution" vertex="1">
          <mxGeometry height="720" width="760" x="540" y="110" as="geometry" />
        </mxCell>
        <mxCell id="11" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=16;fontColor=#0f172a;align=center;verticalAlign=top;spacingLeft=16;spacingTop=12;" value="Phase 2. Single-Condition Analysis Engine" vertex="1">
          <mxGeometry height="1080" width="760" x="540" y="870" as="geometry" />
        </mxCell>
        <mxCell id="12" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;fontStyle=1;fontSize=16;fontColor=#0f172a;align=center;verticalAlign=top;spacingLeft=16;spacingTop=12;" value="Phase 3. Paired Comparison And Batch Reporting" vertex="1">
          <mxGeometry height="540" width="760" x="540" y="1990" as="geometry" />
        </mxCell>
        <mxCell id="20" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;1. Entry Point&lt;/b&gt;&lt;br&gt;Run &lt;code style=&quot;&quot;&gt;post/repeatability_experiment_report.py&lt;/code&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="72" width="520" x="660" y="160" as="geometry" />
        </mxCell>
        <mxCell id="21" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;2. Load Config And CLI Overrides&lt;/b&gt;&lt;br&gt;Read experiment root, output root, atlas directory, cohort options and selected conditions from the JSON config plus CLI arguments.&lt;/font&gt;" vertex="1">
          <mxGeometry height="102" width="520" x="660" y="260" as="geometry" />
        </mxCell>
        <mxCell id="22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;3. Resolve ROI Explicitly&lt;/b&gt;&lt;br&gt;CLI ROI settings override &lt;code style=&quot;&quot;&gt;config.analysis&lt;/code&gt;.&lt;br&gt;Uses &lt;code style=&quot;&quot;&gt;roi_preset&lt;/code&gt; or &lt;code style=&quot;&quot;&gt;roi_name + roi_labels&lt;/code&gt;.&lt;br&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="122" width="520" x="660" y="390" as="geometry" />
        </mxCell>
        <mxCell id="23" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;4. Resolve Analysis Scope&lt;/b&gt;&lt;br&gt;Select one subject or all subjects.&lt;br&gt;Optionally filter to a condition subset, but the paired report allows at most two conditions.&lt;/font&gt;" vertex="1">
          <mxGeometry height="102" width="520" x="660" y="540" as="geometry" />
        </mxCell>
        <mxCell id="24" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#2563eb;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;5. Dispatch Per Subject And Condition&lt;/b&gt;&lt;br&gt;For each selected subject, call the single-condition analysis once per selected condition using that condition&#39;s &lt;code style=&quot;&quot;&gt;repeats_root&lt;/code&gt;.&lt;/font&gt;" vertex="1">
          <mxGeometry height="108" width="520" x="660" y="680" as="geometry" />
        </mxCell>
        <mxCell id="30" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;6. Single-Condition Subprocess&lt;/b&gt;&lt;br&gt;Call &lt;code style=&quot;&quot;&gt;base_report._run_subject_analysis(...)&lt;/code&gt; from &lt;code style=&quot;&quot;&gt;post/mesh_repeat_report.py&lt;/code&gt;.&lt;/font&gt;" vertex="1">
          <mxGeometry height="84" width="520" x="660" y="930" as="geometry" />
        </mxCell>
        <mxCell id="31" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;7. Build Shared Reference Space&lt;/b&gt;&lt;br&gt;Find &lt;code style=&quot;&quot;&gt;repeat_###&lt;/code&gt; folders, choose the reference repeat, resolve T1 and atlas paths, resample the atlas to the reference T1 grid and create the binary ROI mask.&lt;/font&gt;" vertex="1">
          <mxGeometry height="122" width="520" x="660" y="1060" as="geometry" />
        </mxCell>
        <mxCell id="32" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;8. Load Reference TI And Labels&lt;/b&gt;&lt;br&gt;Load or generate the reference volumetric files, then derive the reference head mask, ROI peak location, high-field mask and centroid used for spatial comparisons.&lt;/font&gt;" vertex="1">
          <mxGeometry height="118" width="520" x="660" y="1210" as="geometry" />
        </mxCell>
        <mxCell id="33" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#d97706;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;9. Per-Repeat Loop&lt;/b&gt;&lt;br&gt;For every repeat:&lt;br&gt;- load or create &lt;code style=&quot;&quot;&gt;TI_Volumetric_*&lt;/code&gt; and &lt;code style=&quot;&quot;&gt;ti_brain_only.nii.gz&lt;/code&gt;&lt;br&gt;- resample labels and TI to the reference grid&lt;br&gt;- normalize TI units when needed&lt;br&gt;- compute mesh, label and E-field metrics&lt;br&gt;- write &lt;code style=&quot;&quot;&gt;repeat_qc/repeat_###_roi_outline_on_ti.png&lt;/code&gt;&lt;br&gt;- append the summary row and update accumulators&lt;/font&gt;" vertex="1">
          <mxGeometry height="224" width="520" x="660" y="1360" as="geometry" />
        </mxCell>
        <mxCell id="34" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;10. Aggregate Across Repeats&lt;/b&gt;&lt;br&gt;Compute repeatability stats for each metric (&lt;code style=&quot;&quot;&gt;n, mean, SD, min, max, CV&lt;/code&gt;), build the mean TI map and label-diff frequency map, check parameter consistency from file hashes and simulation signatures, and optionally compare within-subject variation against the cohort spread.&lt;/font&gt;" vertex="1">
          <mxGeometry height="148" width="520" x="660" y="1620" as="geometry" />
        </mxCell>
        <mxCell id="35" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#16a34a;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;11. Write Per-Condition Outputs&lt;/b&gt;&lt;br&gt;Store condition-level files under &lt;code style=&quot;&quot;&gt;_analysis/&lt;/code&gt;&lt;code style=&quot;&quot;&gt;&amp;lt;subject&amp;gt;/&amp;lt;condition&amp;gt;&lt;/code&gt;, including CSV/JSON summaries, the Markdown report, QC overlays and repeat-level plots.&lt;/font&gt;" vertex="1">
          <mxGeometry height="110" width="520" x="660" y="1800" as="geometry" />
        </mxCell>
        <mxCell id="40" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;12. Paired Comparison Gate&lt;/b&gt;&lt;br&gt;If two conditions are present, load both condition results for the subject and prepare the remesh vs fixed-mesh contrast.&lt;br&gt;If only one condition was analyzed, skip the paired-contrast branch and keep the condition-level outputs.&lt;/font&gt;" vertex="1">
          <mxGeometry height="134" width="520" x="660" y="2050" as="geometry" />
        </mxCell>
        <mxCell id="41" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;13. Compute Paired Contrast&lt;/b&gt;&lt;br&gt;Default baseline = &lt;code style=&quot;&quot;&gt;remesh&lt;/code&gt;, comparison = &lt;code style=&quot;&quot;&gt;fixed_mesh&lt;/code&gt; when available.&lt;br&gt;For each key metric, compute condition means, SDs, CVs, ratios and percent reductions.&lt;/font&gt;" vertex="1">
          <mxGeometry height="122" width="520" x="660" y="2220" as="geometry" />
        </mxCell>
        <mxCell id="42" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#7c3aed;fontColor=#0f172a;fontSize=14;align=left;verticalAlign=middle;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;14. Write Subject And Batch Outputs&lt;/b&gt;&lt;br&gt;Per subject: comparison JSON/Markdown and condition-comparison plots.&lt;br&gt;Across all subjects: append one summary row per subject and finally write &lt;code style=&quot;&quot;&gt;paired_condition_summary.json&lt;/code&gt; and &lt;code style=&quot;&quot;&gt;.csv&lt;/code&gt;.&lt;/font&gt;" vertex="1">
          <mxGeometry height="128" width="520" x="660" y="2380" as="geometry" />
        </mxCell>
        <mxCell id="43" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#0f172a;fontSize=14;align=center;verticalAlign=middle;spacing=8;" value="&lt;b&gt;Done&lt;/b&gt;" vertex="1">
          <mxGeometry height="60" width="200" x="820" y="2540" as="geometry" />
        </mxCell>
        <mxCell id="100" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Required Inputs&lt;/b&gt;&lt;br&gt;&lt;br&gt;- experiment config JSON&lt;br&gt;- remesh and/or fixed_mesh repeat folders&lt;br&gt;- atlas directory with subject atlas NIfTIs&lt;br&gt;- explicit ROI setting&lt;br&gt;- optional cohort root for between-subject comparison&lt;/font&gt;" vertex="1">
          <mxGeometry height="250" width="290" x="70" y="240" as="geometry" />
        </mxCell>
        <mxCell id="101" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Code Path&lt;/b&gt;&lt;br&gt;&lt;br&gt;- driver: &lt;code style=&quot;&quot;&gt;post/repeatability_experiment_report.py&lt;/code&gt;&lt;br&gt;- condition analysis: &lt;code style=&quot;&quot;&gt;post/mesh_repeat_report.py&lt;/code&gt;&lt;br&gt;- ROI and cohort settings are shared through config and CLI overrides&lt;/font&gt;" vertex="1">
          <mxGeometry height="204" width="400" x="1435" y="870" as="geometry" />
        </mxCell>
        <mxCell id="102" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 17px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Per-Repeat Metrics Implemented&lt;/b&gt;&lt;br&gt;&lt;br&gt;- ROI/head mean, median and peak TI&lt;br&gt;- mesh node count&lt;br&gt;- label diff fraction overall and in ROI&lt;br&gt;- hotspot distance in head and ROI&lt;br&gt;- high-field Dice and centroid distance&lt;br&gt;- label presence and voxel counts&lt;/font&gt;" vertex="1">
          <mxGeometry height="200" width="330" x="1460" y="1182" as="geometry" />
        </mxCell>
        <mxCell id="103" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Condition-Level Artifacts&lt;/b&gt;&lt;br&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;summary.csv/json&lt;/code&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;repeatability_stats.csv/json&lt;/code&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;repeatability_report.md&lt;/code&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;parameter_consistency.json&lt;/code&gt;&lt;br&gt;- ROI overlays, diff maps and repeat-level plots&lt;/font&gt;" vertex="1">
          <mxGeometry height="210" width="320" x="70" y="1700" as="geometry" />
        </mxCell>
        <mxCell id="104" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Paired Artifacts&lt;/b&gt;&lt;br&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;condition_comparison.json/md&lt;/code&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;condition_metric_std_comparison.png&lt;/code&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;condition_metric_cv_comparison.png&lt;/code&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;median_roi_by_condition.png&lt;/code&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;mesh_nodes_by_condition.png&lt;/code&gt;&lt;br&gt;- &lt;code style=&quot;&quot;&gt;paired_condition_summary.csv/json&lt;/code&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="190" width="380" x="1435" y="2230" as="geometry" />
        </mxCell>
        <mxCell id="105" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;dashed=1;fontColor=#0f172a;fontSize=13;align=left;verticalAlign=top;spacing=12;" value="&lt;font style=&quot;font-size: 16px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Note&lt;/b&gt;&lt;br&gt;&lt;br&gt;The simulation array job does not run this pipeline automatically.&lt;br&gt;Post-processing starts only when the report script is launched after the repeats exist on disk.&lt;/font&gt;" vertex="1">
          <mxGeometry height="170" width="320" x="70" y="2210" as="geometry" />
        </mxCell>
